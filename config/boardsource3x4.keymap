#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/bt.h>

&kscan0 {
    compatible = "zmk,kscan-gpio-matrix";
    diode-direction = "row2col"; /* ปรับตามทิศทางขีดไดโอดจริงของคุณ */

    row-gpios
        = <&gpio0 6 GPIO_ACTIVE_HIGH>  /* แถวบน สายสีม่วง */
        , <&gpio0 8 GPIO_ACTIVE_HIGH>  /* แถวล่าง สายสีเขียว */
        ;

    col-gpios
        = <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* คอลัมน์ 1 สายสีน้ำเงิน */
        , <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* คอลัมน์ 2 สายสีเทา */
        , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* คอลัมน์ 3 สายสีม่วง */
        , <&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* คอลัมน์ 4 สายสีเหลือง */
        ;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp N1        &kp N2    &kp N3    &kp N4
                &out OUT_TOG  &kp N5    &kp N6    &kp N7
            >;
        };
    };
};
